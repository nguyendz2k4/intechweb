# Canonical public origin. Changing this requires a rebuild and redeploy.
NEXT_PUBLIC_SITE_URL=https://website.example

# MariaDB 10.6 / MySQL 8. cPanel host: localhost; laptop remote host: 103.57.221.79.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
# Enable only when your MySQL server supports TLS; certificate verification remains enabled.
DB_SSL=false
DB_SSL_CA_FILE=
# Optional mysql://user:encoded-password@host:3306/database overrides DB_* credentials.
# Keep blank when configuring the separate DB_* variables above.
DATABASE_URL=
# Maintenance credentials belong only in maintenance processes/secret storage.
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
RESTORE_TARGET_ENV=staging

# Production admin: signed HttpOnly cookie, server RBAC, password-only login.
ADMIN_ENABLED=true
ADMIN_MFA_REQUIRED=false
ADMIN_SESSION_SECRET=
# Retain existing encryption keys with backups; required only when MFA is enabled.
ADMIN_CREDENTIAL_ENCRYPTION_KEY=
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_TRUSTED_ORIGINS=https://website.example
# Optional multi-account configuration. Direct credentials below take priority when MFA is false.
# JSON [{username,passwordHash,role}], role: admin/editor/support.
# Generate salted hash: node scripts/hash-admin-password.mjs
ADMIN_ACCOUNTS_JSON=
# Production credentials when ADMIN_MFA_REQUIRED=false. Password length 8–256.
ADMIN_USER=
ADMIN_PASSWORD=

# Production requires persistent atomic rate-limit backend.
RATE_LIMIT_BACKEND=database
# Only trust a header that ingress removes and overwrites with a single IP.
RATE_LIMIT_TRUSTED_IP_HEADER=

RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_ENABLED=true
WARRANTY_LOOKUP_ENABLED=true
UPLOADS_ENABLED=true
# Local uploads on production require persistent shared storage.
UPLOAD_STORAGE=local
UPLOAD_LOCAL_PERSISTENT=false
# Vercel: set UPLOAD_STORAGE=vercel-blob and a token from the CUSTOMER's public Blob store.
# Server uploads are limited to 3 MiB for every file on Vercel.
BLOB_READ_WRITE_TOKEN=
# Restricted uptime probe: Authorization: Bearer <token>, GET /api/health.
HEALTHCHECK_TOKEN=
