{
  "name": "intechna-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "node scripts/ci-build.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "format:check": "prettier --check app components scripts tests \"*.{ts,js,mjs,json,yml,yaml}\" \"../.github/workflows/*.{yml,yaml}\"",
    "format": "prettier --write app components scripts tests \"*.{ts,js,mjs,json,yml,yaml}\" \"../.github/workflows/*.{yml,yaml}\"",
    "db:push": "drizzle-kit push",
    "db:migrate:admin": "node scripts/db-migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "security:audit:db": "node scripts/security-db-audit.mjs",
    "security:preflight": "node scripts/production-preflight.mjs",
    "security:cleanup": "node scripts/security-cleanup.mjs",
    "admin:setup:owner": "node scripts/setup-owner-admin.mjs",
    "admin:recover": "node scripts/recover-admin.mjs",
    "content:export": "tsx scripts/content-transfer.ts export",
    "content:import": "tsx scripts/content-transfer.ts import",
    "content:validate": "tsx scripts/content-transfer.ts validate",
    "handover:package": "node scripts/package-handover.mjs",
    "handover:verify": "node scripts/verify-handover.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/security-db-audit.mjs",
    "start:cpanel": "node server.js"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@vercel/blob": "2.8.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "mysql2": "^3.24.6",
    "next": "16.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2"
  }
}
